{% import "macros/dashboard.njk" as dashboard %}
{% extends "pages/dashboard/dashboard-template.njk" %}

{% block sidebar %}
  {{ dashboard.sidebar("reviews") }}
{% endblock %}

{% block content %}
  {{ dashboard.header("Reviews", tailor) }}

  <section>
    {% for item in rData %}
      <div
        class="homec-testimonial homec-testimonial--v2 mg-top-30"
        style="border: 1px solid lavender;"
      >
        <div class="homec-testimonial__main">
          <ul class="homec-rating list-none mg-btm-15">
            {% set stars =  (item.review.rating / 2) | round %}
            {% for i in range(0, stars) %}
              <li><i class="fa-solid fa-star"></i></li>
            {% endfor %}
            <span class="homec-primary-color" style="font-weight: 600;"
              >{{ item.review.rating }}/10</span
            >
          </ul>
          <span class="homec-primary-color"
            >{{ item.review.createdAt | daysSince }} days ago
          </span>
          <p
            class="homec-testimonial__text"
            style="font-size: 18px; line-height: 2"
          >
            {{ item.review.content }}
          </p>
          <div class="homec-testimonial__bottom mg-top-10">
            <div class="homec-testimonial__author">
              <div class="homec-testimonial__author--info">
                <h5 class="homec-testimonial__author--title">
                  {{ item.client.firstName }}
                  {{ item.client.lastName }}
                </h5>
                <p class="homec-testimonial__author--position">Client</p>
              </div>
            </div>
          </div>
        </div>
        <div class="homec-testimonial__img">
          <div class="homec-testimonial__quote">
            <i class="fa-solid fa-quote-left"></i>
          </div>
          <img
            loading="lazy"
            src="{{ item.client.image }}"
            alt="
                          photo of 
                          {{ item.client.firstName }} 
                          {{ item.client.lastName }}"
          />
        </div>
      </div>
    {% endfor %}
  </section>
{% endblock %}
